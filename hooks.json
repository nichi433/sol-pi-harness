{
  "sol-pi-observation-pack": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command|Bash|bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -m solpi.hook_runner PreToolUse",
            "timeout": 10
          }
        ]
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "python3 -m solpi.hook_runner PreInvocation",
        "timeout": 5
      }
    ]
  }
}
